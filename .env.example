# =========================================================
# 環境変数のひな形(値は空のまま Git に入れる)
# 使い方: このファイルをコピーして .env.local を作り、= の右に値を入れる。
#        .env.local は .gitignore 済みなので Git には入らない。
#        .env.local には「開発用」の Supabase プロジェクトの値を入れる(本番の値は入れない)。
#        本番の DB にマイグレーションを流すときだけ、別に .env.prod.local を作り、本番の DIRECT_URL だけを書く。
#        (.env.production.local という名前は使わない。手元の next build / next start が自動で読んでしまうため)
# =========================================================

# --- Supabase(画面とサーバーの両方で使う。NEXT_PUBLIC_ が付くとブラウザにも渡る) ---

# プロジェクトのURL(https://xxxx.supabase.co の形)
# 場所: Supabase 管理画面 > 対象プロジェクト > 上部の「Connect」ボタン > 「App Frameworks」タブ(Next.js)
#       または Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# ブラウザに渡してよい公開用キー(RLS で守られる前提のキー)
# 場所: Project Settings > API Keys > 「Publishable key」(sb_publishable_ で始まる)
#       画面が古い場合は「Legacy API Keys」タブの anon / public キーでも可
# ※ 同じ画面にある secret key / service_role キーはここに入れない(管理者権限のため)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Prisma(サーバー側だけで使う。ブラウザには渡らない) ---
# どちらも「Connect」>「Connection String」タブで **Shared Pooler(IPv4 対応)** を選んでコピーする。
#   正しい形: ホストが「….pooler.supabase.com」で終わり、ユーザー名が「postgres.<project-ref>」
#   使わない: ホストが「db.<project-ref>.supabase.co」のもの(Direct connection / Dedicated Pooler)。
#             無料プランでは IPv6 専用で、この PC からも Vercel からもつながらない
# [YOUR-PASSWORD] はプロジェクト作成時に決めたDBパスワードに置き換える

# アプリが普段使うDB接続(Transaction pooler、ポート 6543)。Vercel にも設定する(Production は本番、Preview は開発用の値)
#   末尾に ?pgbouncer=true を付ける(接続プールで正しく動くため)
DATABASE_URL=

# マイグレーション(テーブル作成・変更)専用の接続(Session pooler、ポート 5432)
#   手元でマイグレーションするときだけ使う。Vercel には設定しない
DIRECT_URL=
