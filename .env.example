# =========================================================
# 環境変数のひな形(値は空のまま Git に入れる)
# 使い方: このファイルをコピーして .env.local を作り、= の右に値を入れる。
#        .env.local は .gitignore 済みなので Git には入らない。
# =========================================================

# --- Supabase(画面とサーバーの両方で使う。NEXT_PUBLIC_ が付くとブラウザにも渡る) ---

# プロジェクトのURL(https://xxxx.supabase.co の形)
# 場所: Supabase 管理画面 > 対象プロジェクト > 上部の「Connect」ボタン > 「App Frameworks」タブ(Next.js)
#       または Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# ブラウザに渡してよい公開用キー(RLS で守られる前提のキー)
# 場所: Project Settings > API Keys > 「Publishable key」(sb_publishable_ で始まる)
#       画面が古い場合は「Legacy API Keys」タブの anon / public キーでも可
# ※ 同じ画面にある secret key / service_role キーはここに入れない(管理者権限のため)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Prisma(サーバー側だけで使う。ブラウザには渡らない) ---

# アプリが普段使うDB接続(接続プール経由。ポート 6543)
# 場所: 上部の「Connect」ボタン > 「ORMs」タブ(Prisma)または「Connection String」タブの
#       「Transaction pooler」。[YOUR-PASSWORD] はプロジェクト作成時に決めたDBパスワードに置き換える
#       末尾に ?pgbouncer=true を付ける(Prisma が接続プールで正しく動くため)
DATABASE_URL=

# マイグレーション(テーブル作成・変更)専用の接続(ポート 5432)
# 場所: 同じ「Connect」画面の「Session pooler」(または Direct connection)の接続文字列
DIRECT_URL=
